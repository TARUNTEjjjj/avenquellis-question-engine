{
  "name": "@avenquellis/question-engine",
  "version": "0.1.0",
  "description": "Deterministic mathematics practice generation with solutions and criterion rubrics",
  "type": "module",
  "exports": "./src/index.js",
  "scripts": {
    "test": "node --test test/engine.test.js test/advanced-templates.test.js test/server.test.js test/resources-api.test.js",
    "start": "node src/server.js",
    "build:exact": "node scripts/build-exact.mjs",
    "test:exact": "node --test test/exact-math.test.mjs",
    "test:all": "node --test test/engine.test.js test/advanced-templates.test.js test/server.test.js test/exact-math.test.mjs",
    "resources:refresh": "node scripts/resources/resource-server.mjs refresh --config resources/sources.json --output resources/catalog.json",
    "resources:serve": "node scripts/resources/resource-server.mjs serve --config resources/sources.json --snapshot resources/catalog.json",
    "test:resources": "node --test scripts/resources/resource-catalog.test.mjs && node scripts/resources/check-catalog.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
