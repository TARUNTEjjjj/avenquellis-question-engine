function(check)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}\n${out}\n${err}")
    endif()
endfunction()
# CONFIG is empty for a single-config build without CMAKE_BUILD_TYPE. check's unquoted
# ${ARGV} drops empty values, so pass the configuration options only when it is set.
set(config_args)
set(ctest_config_args)
if(NOT CONFIG STREQUAL "")
    set(config_args --config "${CONFIG}")
    set(ctest_config_args -C "${CONFIG}")
endif()
set(prefix "${BUILD}/consumer-prefix")
set(consumer "${BUILD}/consumer-build")
file(REMOVE_RECURSE "${prefix}" "${consumer}")
check("${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${prefix}" ${config_args})
check("${prefix}/${BINDIR}/noether-questions" --help)
check("${prefix}/${BINDIR}/avenquellis-questions" chapter --topic algebra --count 2)
foreach(mode IN ITEMS canonical legacy)
    check("${CMAKE_COMMAND}" -S "${SOURCE}/test/consumer" -B "${consumer}/${mode}" "-DCMAKE_PREFIX_PATH=${prefix}"
        "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DMODE=${mode}" "-DEXAMPLE_SOURCE=${SOURCE}/examples/chapter.cpp")
    check("${CMAKE_COMMAND}" --build "${consumer}/${mode}" ${config_args})
    check("${CMAKE_CTEST_COMMAND}" --test-dir "${consumer}/${mode}" --output-on-failure ${ctest_config_args})
endforeach()
